#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PACKAGE_VERSION_MAJOR@,@PACKAGE_VERSION_MINOR@
PRODUCTVERSION  @PACKAGE_VERSION_MAJOR@,@PACKAGE_VERSION_MINOR@

BEGIN

	BLOCK "StringFileInfo"
	BEGIN
        	BLOCK "080904E4"
		BEGIN
			VALUE "FileDescription",	"3270 Language Binding helper library\0"
			VALUE "CompanyName",		"Banco do Brasil S/A.\0"
			VALUE "FileVersion",		"@PACKAGE_VERSION_MAJOR@.@PACKAGE_VERSION_MINOR@.@PACKAGE_VERSION_MICRO@.0\0"
            VALUE "LegalCopyright",		"(C) 2019 Banco do Brasil S/A. All Rights Reserved\0"
			VALUE "OriginalFilename",	"ipc3270.dll\0"
			VALUE "ProductName",		"@PRODUCT_NAME@\0"
			VALUE "ProductVersion",		"@PACKAGE_VERSION_MAJOR@.@PACKAGE_VERSION_MINOR@.@PACKAGE_VERSION_MICRO@.0\0"
		END
	END

	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x809, 0x04E4
	END

END

